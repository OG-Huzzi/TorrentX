{
  "name": "torrentx",
  "version": "0.3.0",
  "description": "Fast, adaptive torrent meta-search for every terminal.",
  "type": "module",
  "bin": {
    "torrentx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/tool.mjs node_modules/tsx/dist/cli.mjs src/cli.ts",
    "build": "node scripts/tool.mjs node_modules/tsup/dist/cli-default.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node scripts/tool.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/tool.mjs node_modules/vitest/vitest.mjs",
    "test:coverage": "node scripts/tool.mjs node_modules/vitest/vitest.mjs run --coverage",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "postinstall": "node scripts/patch-webtorrent.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "torrent",
    "magnet",
    "meta-search",
    "terminal",
    "cli",
    "tui",
    "termux",
    "anime",
    "movies"
  ],
  "license": "MIT",
  "overrides": {
    "esbuild": "$esbuild"
  },
  "dependencies": {
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "fast-xml-parser": "^5.2.5",
    "ink": "^7.1.1",
    "parse-torrent": "^11.0.24",
    "react": "^19.3.0",
    "socks": "^2.8.10",
    "undici": "^6.27.0",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^5.0.2"
  }
}
